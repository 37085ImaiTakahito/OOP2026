@using SelfOrderSystem.Models
@model List<Order>

@{
    ViewData["Title"] = "店舗注文管理";

    int activeCount = Model.Count(o => o.Status != OrderStatus.Served);
    int servedCount = Model.Count(o => o.Status == OrderStatus.Served);
}

<link rel="stylesheet"
      href="~/css/staff.css"
      asp-append-version="true" />

<div class="staff-page">

    <div class="staff-header">
        <div>
            <p class="staff-eyebrow">STAFF DASHBOARD</p>
            <h1>店舗注文管理</h1>
            <p>最新50件の注文を表示中</p>
        </div>

        <span class="staff-header-label">
            ORDER MANAGEMENT
        </span>
    </div>

    <div class="staff-summary">

        <div class="staff-summary-box">
            <span>表示件数</span>
            <strong>@Model.Count</strong>
        </div>

        <div class="staff-summary-box">
            <span>対応中</span>
            <strong>@activeCount</strong>
        </div>

        <div class="staff-summary-box">
            <span>提供済み</span>
            <strong>@servedCount</strong>
        </div>

    </div>

    @if (!Model.Any()) {
        <div class="staff-empty">
            <h2>現在注文はありません</h2>
            <p>新しい注文が入るとここに表示されます</p>
        </div>
    }
    else {
        <div class="staff-order-grid">

            @foreach (var order in Model) {
                var total = order.Items.Sum(i => i.UnitPrice * i.Quantity);
                var itemCount = order.Items.Sum(i => i.Quantity);

                var elapsedMinutes =
                (int)(DateTime.UtcNow - order.OrderedAtUtc)
                .TotalMinutes;

                <article class="staff-order-card status-@order.Status.ToString().ToLower()">

                    <div class="staff-order-top">

                        <div class="staff-order-identity">

                            <span class="staff-table-number">
                                卓 @order.TableNumber
                            </span>

                            <div>

                                <div class="staff-order-id">
                                    #@order.Id.ToString("D6")
                                </div>

                                <time class="staff-order-time">
                                    @(order.OrderedAtUtc
                                    .ToLocalTime()
                                    .ToString("yyyy/MM/dd HH:mm"))
                                </time>


                                <div class="staff-order-elapsed @(elapsedMinutes >= 15 ? "warning" : "")">
                                    注文後 @elapsedMinutes 分
                                </div>

                            </div>

                        </div>

                        <span class="staff-status @order.Status.BadgeClass()">
                            @order.Status.ToJapanese()
                        </span>

                    </div>

                    <div class="staff-progress">
                        <div class="staff-progress-bar"
                             style="width:@order.Status.Progress()%">
                        </div>
                    </div>

                    <div class="staff-order-items">

                @foreach (var item in order.Items) {
                            <div class="staff-order-item">

                                <span>
                                    @item.Product?.Name
                                </span>

                                <strong>
                                    × @item.Quantity
                                </strong>

                            </div>
                        }

                    </div>

                    <div class="staff-order-bottom">

                        <div class="staff-total">
                            <span>@itemCount 品</span>
                            <strong>
                                ¥@total.ToString("N0")
                            </strong>
                        </div>

                        @if (!order.Status.IsCompleted()) {
                            <form asp-controller="Staff"
                                  asp-action="Advance"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@order.Id" />

                                <button type="submit"
                                        class="btn staff-action-button">
                                    @order.Status.NextActionLabel()
                                </button>

                            </form>
                        }
                        else {
                            <span class="staff-completed">
                                完了 ✓
                            </span>
                        }

                    </div>

                </article>
            }

        </div>
    }

</div>

@section Scripts
{
    <script src="~/js/signalr/dist/browser/signalr.min.js"></script>

    <script>

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/staffOrdersHub")
            .withAutomaticReconnect()
            .build();

        connection.on("OrdersChanged", () => {
            window.location.reload();
        });

        connection.onreconnected(() => {
            window.location.reload();
        });

        connection.start()
            .catch(error => {
                console.error("SignalR接続エラー", error);
            });

    </script>
}