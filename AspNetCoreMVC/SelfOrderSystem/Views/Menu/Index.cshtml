@model SelfOrderSystem.ViewModels.MenuViewModel

@{
    ViewData["Title"] = "メニュー";
}

<h1 class="h3 mb-3">メニュー</h1>

<div class="d-flex gap-2 overflow-auto pb-3">
    <a class="btn @(Model.SelectedCategoryId == null ? "btn-dark" : "btn-outline-dark")"
       asp-action="Index">
        すべて
    </a>

    @foreach (var category in Model.Categories) {
        <a class="btn @(Model.SelectedCategoryId == category.Id ? "btn-dark" : "btn-outline-dark")"
           asp-action="Index"
           asp-route-categoryId="@category.Id">
            @category.Name
        </a>
    }
</div>
